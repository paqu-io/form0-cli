{
  "name": "form0-cli",
  "version": "0.1.18",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Command-line tools for form0, the open-source schema-driven form ecosystem by paqu.io. Scaffold, validate, test and preview form schemas locally.",
  "type": "module",
  "scripts": {
    "format": "prettier --write \"**/*.{js,jsx,json,ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,ts,tsx,md}\"",
    "generate-localazy-config": "node scripts/generate-localazy-config.js",
    "localazy:upload": "npm run generate-localazy-config && localazy upload",
    "localazy:download": "npm run generate-localazy-config && localazy download"
  },
  "bin": {
    "form0": "./bin/form0.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paqu-io/form0-cli.git"
  },
  "keywords": [
    "form0",
    "paqu-io",
    "cli",
    "form-engine",
    "schema-driven-forms",
    "json-schema",
    "dynamic-forms",
    "form-validation",
    "developer-tools",
    "scaffolding"
  ],
  "author": "paqu.io <hello@paqu.io> (https://paqu.io/)",
  "contributors": [
    {
      "name": "aragornii"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/paqu-io/form0-cli/issues"
  },
  "homepage": "https://form0.dev",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "acorn": "^8.17.0",
    "chalk": "^5.4.1",
    "chokidar": "^3.6.0",
    "commander": "^11.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "form0-core": "^0.1.26",
    "fs-extra": "^11.1.1",
    "tar": "^7.4.3",
    "uuid": "^11.1.0",
    "ws": "^8.18.3",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "ignore": "^7.0.5",
    "prettier": "^3.5.3"
  },
  "optionalDependencies": {
    "keytar": "npm:null@*"
  }
}
